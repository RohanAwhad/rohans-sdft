VERTEXAI_LOCATION=us-east5
REFLECTOR_PROJECT_ID=

WANDB_PROJECT=sdft-online
WANDB_ENTITY=
WANDB_NAME=

# Objective: sdft keeps the existing reverse-KL path; grpo uses verdict rewards.
LOSS_TYPE=sdft
GRPO_GROUPS=8
GRPO_ADV=mean
GRPO_CLIP_LOW=0.2
GRPO_CLIP_HIGH=0.28
GRPO_OLD_LOGPS=vllm
GRPO_IS_C_MAX=3.0
GRPO_IS_MODE=truncate
GRPO_KL_COEF=0.0
GRPO_KL_REF=ema_teacher
GRPO_FILTER_GROUPS=0
GRPO_MAX_GEN_BATCHES=10
GRPO_LR=1e-6
GRPO_LR_WARMUP_STEPS=15
GRPO_GRAD_CLIP=0.2
GRPO_MASK_TRUNCATED=1

# Importance sampling (vLLM rollout proposal vs training policy)
IS_WEIGHTING=1
IS_CAP=5.0

# Async streaming rollouts (see docs/megatron_trainer/async_rollouts.md)
ASYNC_ROLLOUT=0
N_ASYNC=64

# Determinism for A/B verification runs (unset = nondeterministic)
# TRAINER_SEED=42
# VLLM_SEED=42
